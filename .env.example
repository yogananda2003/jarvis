# ── JARVIS Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# ── LLM overrides ──────────────────────────────────────────────────────────
# JARVIS_LLM__MODEL=mistral
# JARVIS_LLM__BASE_URL=http://localhost:11434

# ── Debug mode ─────────────────────────────────────────────────────────────
# JARVIS_JARVIS__DEBUG=true

# ── Email tool credentials ─────────────────────────────────────────────────
# JARVIS_EMAIL_USER=you@example.com
# JARVIS_EMAIL_PASSWORD=your-app-password

# ── Wake word (Picovoice) ──────────────────────────────────────────────────
# PICOVOICE_ACCESS_KEY=your-key-here

# ── API server ─────────────────────────────────────────────────────────────
# JARVIS_API__PORT=8000
